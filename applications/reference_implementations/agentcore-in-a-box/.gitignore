# Compiled CDK/TypeScript output (root + lib + bin only — NOT frontend source)
/*.js
/*.d.ts
lib/**/*.js
lib/**/*.d.ts
bin/**/*.js
bin/**/*.d.ts
test/**/*.js
test/**/*.d.ts
!jest.config.js
node_modules
__pycache__/
*.pyc

# CDK asset staging directory
.cdk.staging
cdk.out

# Deployment artifacts / generated config (machine-specific, may contain account IDs)
cdk-outputs.json
.deployment-outputs.json
.deploy-*.log

# React frontend build output + generated runtime config (regenerated by deploy.sh)
frontend-react/dist
frontend-react/dist/config.js

# Parallel-deploy (DEMO_ENV) generated files
.deployment-outputs-*.json
cdk-outputs-*.json
docs/diagram-icons.json

# Per-clone deploy env suffix (auto-generated; reused by re-runs + cleanup)
.demo-env
.demo-env.bak*

# Demo credentials written by deploy.sh (never committed; contains the demo password)
.demo-creds*

# FRED API key (real credit-spread data source) — secret, never commit.
# deploy.sh reads this and injects it into the bond-ingest Lambda as an env var.
.fred-key

# EKS market-data: the shared API key the Gateway injects (SECRET, never commit) + the resolved
# endpoint outputs (machine-specific, regenerated by eks/deploy_eks.sh).
.eks-market-key-*
.eks-outputs-*.json

# macOS
.DS_Store
.claude/settings.local.json

.omc/
.omc/*
**/.omc/
**/.omc/*
