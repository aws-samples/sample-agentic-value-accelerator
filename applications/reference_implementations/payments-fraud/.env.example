# --- Model configuration ---
# Supervisor + investigation + SAR use a Sonnet-class model; the scorer can use a
# faster model. Defaults below match the AVA control-plane templates.
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
SCORER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
TEMPERATURE=0.1
MAX_TOKENS=4096
LOG_LEVEL=INFO

# --- Strands ---
MEMORY_WINDOW_SIZE=20

# --- Data stores (injected by Terraform at deploy time) ---
TXN_TABLE=
CASES_TABLE=
SARS_TABLE=
DATA_BUCKET=
DATA_PREFIX=samples/payments_fraud

# --- Observability (Langfuse) ---
# Provided by the agent-observability / foundation-stack template. When unset,
# tracing falls back to CloudWatch/X-Ray only.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Guardrails (optional) ---
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
