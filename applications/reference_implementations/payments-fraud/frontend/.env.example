# Copy to .env.local and fill in from your Terraform outputs (see the repo README).

# Server-side only (never exposed to the browser) — the BFF uses these to invoke AgentCore.
AWS_REGION=us-east-1
# From `terraform output -raw agentcore_runtime_arn`
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<account-id>:runtime/<runtime-id>
# AWS credentials are taken from the standard provider chain (env, profile, or role).

# Cognito (exposed to browser for Amplify login). When both pool id + client id are
# set, the app requires Cognito sign-in. Leave them empty to run open (no login gate).
# From `terraform output -raw cognito_user_pool_id` / `cognito_web_client_id`.
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
