# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

project_name = "payments-fraud"
aws_region   = "us-east-1"
environment  = "dev"

# First apply: leave empty to create the ECR repo, then build & push the image,
# set this to the pushed URI, and apply again.
container_image_uri = ""

# Models
model_id        = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
scorer_model_id = "us.anthropic.claude-haiku-4-5-20251001-v1:0"

# Observability — point at an existing Foundation Stack / agent-observability Langfuse.
# Leave empty to disable Langfuse (runtime still emits CloudWatch + X-Ray).
langfuse_host       = ""
langfuse_public_key = ""
langfuse_secret_key = ""

# Auth — set to your CloudFront URL once the frontend is deployed.
callback_urls = ["http://localhost:3000/callback"]
logout_urls   = ["http://localhost:3000"]
