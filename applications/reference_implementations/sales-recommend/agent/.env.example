# Sales Recommend Agent — Environment Variables

# Deployment
DEPLOYMENT_MODE=agentcore    # agentcore | fastapi

# AWS
AWS_REGION=us-east-1
KNOWLEDGE_BASE_ID=H1LK4MDM6O

# Model
MODEL_ID=global.anthropic.claude-sonnet-4-6
MAX_TOKENS=16384

# Logging
LOG_LEVEL=INFO

# Observability (optional — leave blank to disable)
ENABLE_TRACING=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
