# from the deployment form (deployment.json parameters).

aws_region           = "us-east-1"
project_name         = "sales-recommend"
environment          = "prod"
# knowledge_base_id is DEPRECATED/UNUSED — the stack self-provisions its own
# Knowledge Base (see modules/knowledge-base). Leave blank.
