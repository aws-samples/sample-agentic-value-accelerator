# Sales Recommend UI — Environment Variables
# These are injected into the ECS Task Definition at deploy time.

# AWS Credentials (for the /api/chat proxy to invoke AgentCore)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AgentCore Runtime (output from terraform apply)
AGENT_RUNTIME_ARN=
AGENT_RUNTIME_QUALIFIER=DEFAULT
