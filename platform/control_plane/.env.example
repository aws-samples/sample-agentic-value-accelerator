# AVA Control Plane — Local Development Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is loaded automatically by Finch/Docker Compose.
# Never commit the actual .env file (it's in .gitignore).

# --- Bedrock Mantle (required for GPT-5.5 / GPT-5.4 models) ---
# Generate an API key from the Bedrock Mantle console:
# https://console.aws.amazon.com/bedrock/home#/mantle/api-keys
BEDROCK_MANTLE_API_KEY=

# --- AWS Region (optional, defaults to us-east-2) ---
# AWS_REGION=us-east-2
