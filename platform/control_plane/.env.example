# AVA Control Plane — Local Development Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is loaded automatically by Finch/Docker Compose.
# Never commit the actual .env file (it's in .gitignore).

# --- Bedrock Mantle (required for GPT-5.5 / GPT-5.4 models) ---
# Generate an API key from the Bedrock Mantle console:
# https://console.aws.amazon.com/bedrock/home#/mantle/api-keys
BEDROCK_MANTLE_API_KEY=

# --- AWS Region (optional, defaults to us-east-2) ---
# AWS_REGION=us-east-2

# --- Authentication ---
# Leave ENVIRONMENT unset for local work; it defaults to "development", which is what
# permits the dev auth bypass that docker-compose.yaml turns on.
#
# For any deployment reachable by anyone else, set this to your real environment name.
# The bypass returns a hardcoded admin WITHOUT reading the presented credential, and its
# own default is "on", so an environment that never mentions it is unauthenticated. Any
# value outside development / dev / local / test refuses the bypass regardless of
# USE_DEV_AUTH or DEBUG. Check which way it resolved:
#   docker compose logs backend | grep AUTH-GATE
# ENVIRONMENT=production

# --- Outbound HTTP (optional, empty by default) ---
# Comma-separated CIDRs whose addresses may be fetched even though they are not publicly
# routable. Needed only to reach a private OIDC issuer or an in-VPC A2A peer. Loopback,
# link-local (instance metadata), multicast and 0.0.0.0 can never be permitted by any
# value here. See README.md, "Outbound HTTP".
# SAFE_FETCH_ALLOWED_PRIVATE_CIDRS=10.20.0.0/16
