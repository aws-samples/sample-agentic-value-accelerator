# AWS Configuration
#
# All three region settings below are read by platform/control_plane/docker-compose.yaml via
# ${VAR:-default} interpolation, so setting them here (or exporting them) is enough to move a
# local stack. They used to be baked into that file as literals, which made them the only
# region settings a deployer could not override; `docker compose config` is the way to
# confirm what the container will actually receive.
#
# Two regions, deliberately. They answer different questions, and getting them backwards
# fails SILENTLY: an AWS API call against the wrong region does not raise, it succeeds and
# returns that region's smaller or empty inventory. The Operations Hub reported a 1-agent
# fleet instead of the real 36 that way, under a Live badge. Resolution logic lives in
# backend/src/core/region_config.py.
AWS_REGION=us-east-1        # Control plane (tier 1): AVA's own DynamoDB tables, ECS, ALBs.
                            # Read-write, so single-region by construction.

# Governed fleet (tier 2): the customer's Bedrock agents, AgentCore runtimes, guardrails,
# and the CloudWatch metrics they emit. Read-only, so it may legitimately differ from
# AWS_REGION - in the demo account it does (AWS_REGION=us-east-2, GOVERN_AWS_REGION=us-east-1).
#
# LEAVE IT EMPTY when the governed estate is in AWS_REGION. Empty is not "unset and broken",
# it is the documented "follow AWS_REGION": Settings.__init__ resolves an empty value to
# AWS_REGION and records that it was defaulted rather than declared. The default used to be
# the literal "us-east-1", which meant the setting was never empty, that fallback chain never
# ran, and anyone who set only AWS_REGION=eu-west-1 got a control plane in eu-west-1 with a
# governed fleet still read from us-east-1 - a 200 with an empty AI estate, no error to see.
#
# EMPTY IS NOT THE SAME AS ABSENT here, and the difference is what gets prompted. Leaving the
# line present-but-empty is an answer: scripts/deploy.sh sees it in .env and does not ask.
# DELETING the line makes it unanswered, and `deploy.sh local` then prompts for it and writes
# your answer back into .env (which is gitignored) so it asks once per checkout rather than on
# every start. On the Terraform path the same question is var.govern_aws_region, which has no
# default at all and so prompts on every interactive plan/apply.
GOVERN_AWS_REGION=

# Optional region overrides for control-plane tables. Empty means AWS_REGION.
# Resolution order, most specific first:
#   <TABLE_KEY>_TABLE_REGION -> CONTROL_PLANE_TABLE_REGION -> AWS_REGION
# where <TABLE_KEY> is the settings prefix before _TABLE_NAME
# (GUARDRAILS_TABLE_NAME -> GUARDRAILS). Configured, never discovered: probing candidate
# regions for a matching table name would pick one at random, and a control-plane table is
# read-write, so a randomly-picked home is a split-brain write target.
CONTROL_PLANE_TABLE_REGION=
# Leave GUARDRAILS_TABLE_REGION empty unless the guardrails table genuinely is outside
# AWS_REGION. Terraform creates it in var.aws_region, so for a fresh deploy an override can
# only be wrong - it points Scans at a region where no such table exists, which DynamoDB
# answers as an empty result, not an error. The demo account is the exception: its table
# predates the control plane's move to us-east-2 and still lives in us-east-1.
GUARDRAILS_TABLE_REGION=
AWS_ACCOUNT_ID=123456789012

# Environment
ENVIRONMENT=dev

# Existing VPC Configuration (leave empty to create new VPC)
# If you have an existing VPC, provide these values to skip VPC creation
VPC_ID=
PUBLIC_SUBNET_IDS=subnet-xxx,subnet-yyy
PRIVATE_SUBNET_IDS=subnet-aaa,subnet-bbb

# Domain Configuration
DOMAIN_NAME=ava-platform.example.com
HOSTED_ZONE_ID=

# Application Configuration
APP_NAME=control-plane
PROJECT_NAME=ava

# ECS Configuration
ECS_TASK_CPU=512
ECS_TASK_MEMORY=1024
ECS_DESIRED_COUNT=2
ECS_MIN_CAPACITY=1
ECS_MAX_CAPACITY=4

# Database Configuration (for future RDS if needed)
DB_INSTANCE_CLASS=db.t3.micro
DB_ALLOCATED_STORAGE=20

# S3 Configuration
PROJECT_ARCHIVE_RETENTION_DAYS=7

# Cognito Configuration
COGNITO_USER_POOL_NAME=control-plane-users
COGNITO_ENABLE_MFA=false

# Tags
OWNER=platform-team
COST_CENTER=ai-platform
