terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
  # Empty string (default) uses the standard AWS credential chain. Set
  # aws_profile to pin a named profile from ~/.aws/credentials.
  profile = var.aws_profile != "" ? var.aws_profile : null
}
